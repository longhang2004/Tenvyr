{
  "name": "tenvyr",
  "version": "0.1.0",
  "description": "Framework-neutral agent execution control plane for contracts, dispatch, supervision, policy, and durable orchestration",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev:infra": "docker compose up -d",
    "dev:infra:down": "docker compose down",
    "dev": "node scripts/dev.mjs",
    "dev:java": "TENVYR_BACKEND=java node scripts/dev.mjs",
    "dev:orchestrator": "sh scripts/java-backend.sh control-plane",
    "dev:gateway": "sh scripts/java-backend.sh gateway",
    "dev:reviewer": "sh scripts/java-backend.sh agents code-reviewer",
    "dev:observability": "sh scripts/java-backend.sh agents observability",
    "dev:frontend": "pnpm --filter frontend run dev",
    "build:all": "pnpm backend:build && pnpm -r build",
    "backend:build": "sh scripts/backend-build.sh",
    "backend:test": "sh scripts/backend-checks.sh pure",
    "backend:integration": "sh scripts/backend-checks.sh --integration",
    "dev:java:orchestrator": "sh scripts/java-backend.sh control-plane",
    "dev:java:gateway": "sh scripts/java-backend.sh gateway",
    "test:all": "pnpm backend:build && pnpm backend:test && pnpm -r --include-workspace-root test",
    "setup:check": "node scripts/setup-check.mjs",
    "showcase:up": "export LLM_PROVIDER=\"${LLM_PROVIDER-mock}\" LLM_FAILURE_MODE=\"${LLM_FAILURE_MODE-}\"; docker compose -p tenvyr-showcase -f docker-compose.yml -f docker-compose.showcase.yml up -d --build && node scripts/smoke-e2e.mjs --health",
    "showcase:seed": "node scripts/smoke-e2e.mjs --seed",
    "showcase:smoke": "node scripts/smoke-e2e.mjs",
    "showcase:down": "docker compose -p tenvyr-showcase -f docker-compose.yml -f docker-compose.showcase.yml down",
    "test:rtk": "./scripts/test-rtk-compress.sh",
    "test:docs": "node --test scripts/verify-docs.test.mjs",
    "test:identity": "node --test scripts/verify-product-identity.test.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:identity": "node scripts/verify-product-identity.mjs",
    "verify:package-packs": "node scripts/verify-package-packs.mjs",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "skills:install": "./scripts/install-skills.sh",
    "codegraph:init": "./scripts/codegraph-init.sh",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "self-hosted:preflight": "sh scripts/java-backend.sh operations preflight",
    "self-hosted:backup": "sh scripts/java-backend.sh operations backup",
    "self-hosted:restore": "sh scripts/java-backend.sh operations restore",
    "self-hosted:upgrade": "sh scripts/java-backend.sh operations upgrade",
    "self-hosted:invariants": "sh scripts/java-backend.sh operations invariants",
    "self-hosted:contract-test": "node --test scripts/self-hosted/contract.test.mjs",
    "self-hosted:recovery-test": "node --test scripts/self-hosted/recovery.test.mjs",
    "self-hosted:health": "curl -s http://127.0.0.1:3001/health",
    "dev:verbose": "TENVYR_LOG_LEVEL=verbose node scripts/dev.mjs",
    "test:dev-ux": "node --test scripts/dev-ux.test.mjs",
    "test:executor-host-rs": "cargo test --manifest-path services/local-executor-host-rs/Cargo.toml",
    "test:java-worker": "mvn -B -f sdks/java-worker/pom.xml test",
    "test:java-worker-loopback": "pnpm --filter orchestrator test:java-worker-loopback",
    "test:cpp-worker": "cmake -S sdks/cpp-worker -B sdks/cpp-worker/build -DCMAKE_CXX_COMPILER=g++ && cmake --build sdks/cpp-worker/build && ctest --test-dir sdks/cpp-worker/build --output-on-failure",
    "test": "node --test scripts/dev-ux.test.mjs",
    "backend:showcase": "node scripts/backend-showcase-check.mjs --cutover",
    "backend:upgrade-check": "node scripts/backend-upgrade-check.mjs",
    "backend:dev-check": "node scripts/backend-dev-check.mjs",
    "dev:host": "sh scripts/java-backend.sh executor-host"
  },
  "devDependencies": {
    "prettier": "^3.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
