# Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agentweave
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=agentweave-dev

# Gateway Service
GATEWAY_PORT=3000
JWT_SECRET=super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Orchestrator Service
ORCHESTRATOR_PORT=3001
ORCHESTRATOR_URL=http://localhost:3001
GATEWAY_URL=http://localhost:3000
ORCHESTRATOR_AGENT_NAMES=code-reviewer,observability
AGENT_TRANSPORT_CONFIG={}
HTTP_AGENT_CALLBACK_MAX_SKEW_SECONDS=300
HTTP_AGENT_REPLAY_TTL_MS=300000
HTTP_AGENT_REPLAY_MAX_ENTRIES=10000

# Agent Runner (Java Spring Boot)
AGENT_RUNNER_PORT=8085
LLM_PROVIDER=openai # anthropic | openai | ollama
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
OLLAMA_API_URL=http://localhost:11434
AGENT_RUNNER_THREAD_POOL_SIZE=10

# Specialized Agents
AGENT_CODE_REVIEWER_PORT=3002
AGENT_OBSERVABILITY_PORT=3003

# Frontend (Next.js)
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:3000
