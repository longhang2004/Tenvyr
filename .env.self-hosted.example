# Self-hosted deployment references (M11) — copy to deploy.env and fill
# from your own secret store. Values here are PLACEHOLDERS, never secrets.
# Every secret is a reference: the compose file consumes these names and
# the VALUES live outside the repository.

# --- PostgreSQL (control-plane authority) ---
# Create: openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Gateway / Orchestrator ---
# Callback base URL reachable from your HTTP Workers
HTTP_AGENT_CALLBACK_BASE_URL=http://127.0.0.1:3000
# JSON map of keyId -> environment-variable NAME holding the signing secret
# e.g. {"workbench-v1":"TENVYR_CALLBACK_SECRET"}
HTTP_AGENT_CALLBACK_KEYS={}
HTTP_AGENT_ALLOW_INSECURE=
# Optional supervision config (JSON) — see docs/operations/configuration.md
ORCHESTRATOR_SUPERVISION_CONFIG={}

# --- Runtime connection secrets (references, per connection) ---
# Each Runtime Connection profile references environment-variable NAMES;
# define the values here or export them in the operator shell:
# CODEX_AUTH_SECRET=
# CLAUDE_CALLBACK_SECRET=
# OPENCODE_AUTH_SECRET=

# --- Version tag for the pinned images ---
# Deployment identity model (one meaning per key):
#   TENVYR_VERSION         = releaseVersion, vMAJOR.MINOR.PATCH, the image
#                            tag; MUST name an existing git tag in this
#                            repository (the exact approved release).
#   TENVYR_SOURCE_REVISION = sourceRevision, the immutable full git commit
#                            SHA the deployed images were built from.
# Create: TENVYR_SOURCE_REVISION=$(git rev-parse HEAD)
TENVYR_VERSION=
TENVYR_SOURCE_REVISION=
