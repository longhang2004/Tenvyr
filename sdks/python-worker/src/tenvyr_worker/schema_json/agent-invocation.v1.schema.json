{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tenvyr:schema:agent-invocation:v1",
  "title": "AgentInvocationV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "invocationId",
    "executionId",
    "stepExecutionId",
    "stepId",
    "target",
    "input",
    "attempt",
    "createdAt",
    "trace"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "invocationId": { "type": "string", "minLength": 1 },
    "executionId": { "type": "string", "minLength": 1 },
    "stepExecutionId": { "type": "string", "minLength": 1 },
    "stepId": { "type": "string", "minLength": 1 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": { "type": "string", "minLength": 1 }
      }
    },
    "input": { "$ref": "#/$defs/jsonValue" },
    "context": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "deadlineAt": { "type": "string", "format": "date-time" },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "correlationId"],
      "properties": {
        "traceId": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "minLength": 1 }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connectionId", "revisionNumber", "configHash"],
      "properties": {
        "connectionId": { "type": "string", "minLength": 1 },
        "revisionNumber": { "type": "integer", "minimum": 1 },
        "configHash": { "type": "string", "minLength": 1 }
      }
    },
    "requestedModelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/\\-:@+]*$"
    }
  },
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      ]
    }
  }
}
