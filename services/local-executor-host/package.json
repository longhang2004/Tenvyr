{
  "name": "@tenvyr/local-executor-host",
  "version": "0.1.0",
  "private": true,
  "description": "Trusted-code-only local process executor host for Tenvyr: runs fixed operator-configured commands with bounded IO, process-group deadline/cancel, and canonical result delivery over the HTTP Worker protocol",
  "license": "MIT",
  "main": "./dist/main.js",
  "scripts": {
    "prebuild": "pnpm --filter @tenvyr/worker build",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "node dist/main.js",
    "pretest": "pnpm run build",
    "test": "jest",
    "pretest:integration": "pnpm run build",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tenvyr/contracts": "workspace:*",
    "@tenvyr/worker": "workspace:*",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.19.41",
    "@types/pg": "^8.11.0",
    "jest": "29.7.0",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["<rootDir>/test/**/*.spec.ts"]
  }
}
