{
  "name": "orchestrator",
  "version": "1.0.0",
  "description": "AgentWeave Orchestrator Service",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "pnpm --filter @agentweave/contracts build",
    "build": "nest build",
    "start": "nest start",
    "prestart:dev": "pnpm --filter @agentweave/contracts build",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "pretest": "pnpm --filter @agentweave/contracts build && pnpm --filter @agentweave/worker build",
    "test": "jest"
  },
  "dependencies": {
    "@agentweave/contracts": "workspace:*",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "ioredis": "^5.3.2",
    "js-yaml": "^4.1.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.17"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/jest": "^29.5.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@agentweave/worker": "workspace:*",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  }
}
