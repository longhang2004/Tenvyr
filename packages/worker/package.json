{
  "name": "@agentweave/worker",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm --filter @agentweave/contracts build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm run build",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentweave/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.19.41",
    "jest": "29.7.0",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
