{
  "name": "@tenvyr/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Framework-neutral TypeScript runtime for the Tenvyr HTTP Worker protocol",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "scripts": {
    "prebuild": "pnpm --filter @tenvyr/contracts build",
    "build": "tsc -p tsconfig.json",
    "pretest": "pnpm run build",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tenvyr/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.19.41",
    "jest": "29.7.0",
    "ts-jest": "29.4.11",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "js",
      "json"
    ]
  }
}
