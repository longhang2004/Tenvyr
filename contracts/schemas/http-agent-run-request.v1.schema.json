{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tenvyr:schema:http-agent-run-request:v1",
  "title": "HttpAgentRunRequestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "invocation", "resultDelivery"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "invocation": {
      "$ref": "urn:tenvyr:schema:agent-invocation:v1"
    },
    "resultDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "callbackUrl", "authentication"],
      "properties": {
        "mode": { "const": "callback" },
        "callbackUrl": { "type": "string", "format": "uri" },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "keyId"],
          "properties": {
            "scheme": { "const": "hmac-sha256" },
            "keyId": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
